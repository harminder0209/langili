{
  "name": "langili",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.20",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "10.11.0",
    "eslint-config-expo": "57.0.2",
    "expo-doctor": "1.20.4",
    "husky": "9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.9",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "wrangler": "4.141.0"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260925.1": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev:pages": "wrangler pages dev dist",
    "export:web": "expo export -p web",
    "cf:types": "wrangler types ./functions/types.d.ts --env-file=.dev.vars.example",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "expo lint",
    "typecheck": "npm run cf:types && tsc --noEmit && tsc --noEmit -p functions",
    "test": "jest",
    "test:e2e:web": "playwright test",
    "test:e2e:native": "maestro test e2e/native",
    "deps:check": "expo install --check && expo-doctor",
    "audit": "npm audit --audit-level=high",
    "scan:dist": "node scripts/scan-dist.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "ci": "npm run check && npm run deps:check && npm run audit && npm run export:web && npm run scan:dist && npm run test:e2e:web",
    "prepare": "husky"
  }
}
